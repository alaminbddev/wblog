{
  "name": "veritron-blog",
  "version": "2.0.0",
  "private": true,
  "description": "Veritron — a fast, secure, privacy-first personal blog built with Eleventy.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "headers": "node scripts/generate-headers.mjs",
    "check": "node scripts/check-site.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "secrets": "node scripts/scan-secrets.mjs",
    "new": "node scripts/new-post.mjs",
    "images:localize": "node scripts/localize-images.mjs",
    "verify": "npm run secrets && npm test && npm run build && npm run check",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true});require('fs').rmSync('.cache',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^31.0.1",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0"
  }
}
