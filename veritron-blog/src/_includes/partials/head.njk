{%- set isHome = (page.url == "/") -%}
{%- set pageTitle = (site.title + " — " + site.tagline) if isHome else ((title + " | " + site.title) if title else site.title) -%}
{%- set pageDesc = descriptionText or description or (subtitle if (subtitle and not isPost) else "") or site.description -%}
{%- set canonicalUrl = canonical or (site.url + page.url) -%}
{%- set ogImage = (image if image else "/images/og-default.png") -%}
{%- set ogImageAbs = ogImage if (ogImage.startsWith("http")) else (site.url + ogImage) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="author" content="{{ author or site.author.name }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)">
<meta name="robots" content="{{ 'noindex, follow' if (noindex or site.noindex) else 'index, follow, max-image-preview:large, max-snippet:-1' }}">
<link rel="canonical" href="{{ canonicalUrl }}">
{%- if pg and pg.n > 1 %}<link rel="prev" href="{{ site.url }}{{ pg.baseUrl if pg.n == 2 else (pg.baseUrl + 'page/' + (pg.n - 1) + '/') }}">{% endif %}
{%- if pg and pg.n < pg.total %}<link rel="next" href="{{ site.url }}{{ pg.baseUrl }}page/{{ pg.n + 1 }}/">{% endif %}

<link rel="icon" href="/images/favicon/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
<link rel="apple-touch-icon" href="/images/favicon/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">
<link rel="alternate" type="application/feed+json" title="{{ site.title }} (JSON)" href="{{ site.url }}/feed.json">

<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="{{ site.locale | replace('-', '_') }}">
<meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:image" content="{{ ogImageAbs }}">
{%- if heroAlt %}<meta property="og:image:alt" content="{{ heroAlt }}">{% endif %}
{%- if isPost %}
<meta property="article:published_time" content="{{ date | dateISO }}">
<meta property="article:modified_time" content="{{ (updated or date) | dateISO }}">
{%- if catLabel %}<meta property="article:section" content="{{ catLabel }}">{% endif %}
{%- for tg in tagItems %}<meta property="article:tag" content="{{ tg.name }}">{% endfor %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ ogImageAbs }}">

{%- if assets.fonts.bengali and site.lang == "bn" %}
<link rel="preload" href="{{ assets.fonts.bengali }}" as="font" type="font/woff2" crossorigin>
{%- endif %}
{%- if assets.fonts.latin %}
<link rel="preload" href="{{ assets.fonts.latin }}" as="font" type="font/woff2" crossorigin>
{%- endif %}
<link rel="stylesheet" href="{{ assets.css }}">
<script src="{{ assets.theme }}"></script>

{#- ---- Structured data ---- #}
{%- if isHome %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": site.url + "/#website", "url": site.url + "/", "name": site.title, "description": site.description, "inLanguage": site.lang,
      "publisher": { "@id": site.url + "/#person" },
      "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": site.url + "/search/?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Person", "@id": site.url + "/#person", "name": site.author.name, "url": site.url + "/about/", "description": site.author.bio }
  ]
} | jsonLd | safe }}</script>
{%- endif %}
{%- if isPost %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BlogPosting", "@id": canonicalUrl + "#article", "mainEntityOfPage": canonicalUrl, "headline": title, "description": pageDesc,
      "image": [ogImageAbs], "datePublished": date | dateISO, "dateModified": (updated or date) | dateISO,
      "author": { "@type": "Person", "name": author, "url": site.url + "/about/" },
      "publisher": { "@type": "Person", "name": site.author.name, "url": site.url + "/" },
      "inLanguage": site.lang, "wordCount": wordCount, "articleSection": catLabel, "keywords": tagItems | pluck("name") | join(", ")},
    { "@type": "BreadcrumbList", "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t.home, "item": site.url + "/" },
      { "@type": "ListItem", "position": 2, "name": catLabel or t.blog, "item": site.url + ("/category/" + catSlug + "/" if catSlug else "/blog/") },
      { "@type": "ListItem", "position": 3, "name": title, "item": canonicalUrl } ] }
  ]
} | jsonLd | safe }}</script>
{%- endif %}
